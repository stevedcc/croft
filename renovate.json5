{
  // Renovate (issue #11). The hosted Mend Renovate GitHub App runs this; CI (ci.yml) must be green
  // before anything automerges. Images are kept current on purpose: the owner prefers a break from
  // an interface change to running an old image (issue #11).
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
    ':dependencyDashboard',
    ':semanticCommitsDisabled',
    'helpers:pinGitHubActionDigests', // actions stay pinned by SHA, Renovate moves the SHA + comment
    'docker:pinDigests',              // Dockerfile FROM lines get @sha256 digests: a .NET patch rebuilds within hours
  ],
  timezone: 'Europe/Berlin',
  // A release must be at least this old before a PR (supply-chain guard: yanked or compromised
  // releases are usually withdrawn within days); automerge simply waits.
  minimumReleaseAge: '3 days',
  prConcurrentLimit: 5,
  prHourlyLimit: 0,
  labels: ['dependencies'],
  // The moving tags (sdk:10.0, aspnet:10.0) stay; only their digests move. A major (11.0) is a brief, not a bot PR.
  packageRules: [
    {
      description: 'Docker base images are Microsoft\'s .NET images (and dev-only compose images): a patch rebuild should deploy within hours, not wait 3 days',
      matchDatasources: ['docker'],
      minimumReleaseAge: null,
    },
    {
      description: 'Majors are planned work (a .NET version, a Playwright major): no PR until ticked on the Dependency Dashboard',
      matchUpdateTypes: ['major'],
      dependencyDashboardApproval: true,
    },
    {
      description: 'The .NET platform moves together: Microsoft.*, System.*, EF Core, Npgsql EF provider',
      matchDatasources: ['nuget'],
      matchPackageNames: ['/^Microsoft\\./', '/^System\\./', '/^Npgsql\\.EntityFrameworkCore/'],
      groupName: '.NET platform packages',
      groupSlug: 'dotnet-platform',
    },
    {
      description: 'Playwright: the NuGet package pins the browser builds the E2E project installs',
      matchDatasources: ['nuget'],
      matchPackageNames: ['/^Microsoft\\.Playwright/', '/^Deque\\.AxeCore\\.Playwright/'],
      groupName: 'Playwright',
    },
    {
      description: 'Everything else from NuGet, one PR',
      matchDatasources: ['nuget'],
      matchPackageNames: ['!/^Microsoft\\./', '!/^System\\./', '!/^Npgsql\\.EntityFrameworkCore/', '!/^Microsoft\\.Playwright/', '!/^Deque\\./'],
      groupName: 'NuGet packages',
    },
    {
      description: 'Automerge what CI can judge: patch, digest and pin updates. Minor and major wait for a human.',
      matchUpdateTypes: ['patch', 'digest', 'pin', 'pinDigest'],
      automerge: true,
      automergeType: 'pr',
      platformAutomerge: true,
    },
    {
      description: 'global.json SDK (datasource dotnet-version; there is no dotnet-version manager, so the old matchManagers rule matched nothing): a new feature band (11.0.200 is a semver "patch" and would otherwise automerge through the rule above) or .NET 12 is a decision, shown on the Dependency Dashboard',
      matchDatasources: ['dotnet-version'],
      automerge: false,
      dependencyDashboardApproval: true,
    },
    {
      description: 'global.json SDK: a patch inside the pinned feature band 11.0.1xx automerges (after the catch-all rule above, so it wins)',
      matchDatasources: ['dotnet-version'],
      matchNewValue: '/^11\\.0\\.1\\d\\d$/',
      dependencyDashboardApproval: false,
      automerge: true,
      automergeType: 'pr',
      platformAutomerge: true,
    },
    {
      description: 'Compose dev images (Postgres, mock OIDC) are dev-only: automerge minors too',
      matchManagers: ['docker-compose'],
      matchUpdateTypes: ['minor', 'patch', 'digest'],
      automerge: true,
    },
  ],
  // Automerge goes through GitHub's own auto-merge (platformAutomerge), which merges a green PR the
  // moment the ruleset's required checks pass, whatever Renovate's run schedule. Always a rebase:
  // auto-release.yml recognises a dependency-only merge by renovate[bot] being the commit's author
  // or committer, which a squash or merge commit by GitHub would hide.
  automergeStrategy: 'rebase',
  // A fix for a known vulnerability never waits for the release age (explicit, not Renovate's default).
  vulnerabilityAlerts: { enabled: true, labels: ['security'], minimumReleaseAge: null },
  osvVulnerabilityAlerts: true,
}
