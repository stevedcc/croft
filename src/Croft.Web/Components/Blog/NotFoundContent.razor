@namespace Croft.Web.Components

@* Spec §5.5: the themed not-found page — the fixed copy plus links to Home and Search.
   Two renderings of one design. An interactive document (the /not-found page, the catch-all, a
   circuit) has MudBlazor's stylesheet and renders text-variant primary MudButtons, which also host
   ThemeTests' dark-mode contrast probe (main a.mud-button-root.mud-button-text-primary, exactly
   two). A static reading page that calls NotFound() (a missing post, category, tag or page)
   renders this same content inside its own static document, which loads no MudBlazor: there it is
   plain markup, drawn by NotFoundContent.razor.css to look the same.
   The catch-all renders under whatever path missed: from a staff path (/admin/…) the links
   cross to the public side and must load a fresh document (see <see cref="AdminArea"/>). *@
@if (InteractiveDocument is false)
{
    <h1 class="not-found__title">This page has wandered off</h1>
    <a class="not-found__link" href="/" @attributes='AdminArea.LinkAttributes(InAdminArea, "/")'>Home</a>
    <a class="not-found__link" href="/search" @attributes='AdminArea.LinkAttributes(InAdminArea, "/search")'>Search</a>
}
else
{
    <MudText Typo="Typo.h3" HtmlTag="h1" Class="mb-2">This page has wandered off</MudText>
    <MudButton Href="/" Variant="Variant.Text" Color="Color.Primary"
               @attributes='AdminArea.LinkAttributes(InAdminArea, "/")'>Home</MudButton>
    <MudButton Href="/search" Variant="Variant.Text" Color="Color.Primary"
               @attributes='AdminArea.LinkAttributes(InAdminArea, "/search")'>Search</MudButton>
}

@code {
    /// <summary>Whether this renders under a staff path (see <see cref="AdminArea"/>).</summary>
    [CascadingParameter(Name = "InAdminArea")] public bool InAdminArea { get; set; }

    /// <summary>Whether the document has MudBlazor loaded, as MainLayout decides it; absent
    /// (outside the layout) counts as interactive.</summary>
    [CascadingParameter(Name = "InteractiveDocument")] public bool? InteractiveDocument { get; set; }
}
