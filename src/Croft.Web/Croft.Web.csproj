<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\Croft.Shared\Croft.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Croft.Web.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Markdig" Version="1.5.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="11.0.0-rc.3.26522.148" />
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" Version="11.0.0-rc.3.26522.148" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="11.0.0-rc.3.26522.148">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="10.11.0" />
    <PackageReference Include="MudBlazor" Version="9.11.0" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="11.0.0-rc.3" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- WORKAROUND(W-025, Blazor): opts into the .NET 10 behaviour where static-SSR NavigateTo no longer throws NavigationException -->
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <!-- END WORKAROUND(W-025) -->
    <!-- WORKAROUND(W-053, .NET): Workstation GC: smaller baseline than Server GC in a pod; measured, re-measure on a new .NET -->
    <!-- Workstation GC is croft-web's default: the GC heap is already capped (75% of a
         container's memory limit), the OOM kills came from memory outside it, and Workstation's
         smaller baseline leaves more of the pod's limit for circuits. A site can still choose
         Server GC with DOTNET_gcServer=1. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <!-- END WORKAROUND(W-053) -->
  </PropertyGroup>

  <!-- WORKAROUND(W-104, .NET SDK): SDK 11 adds a dotnet-watch JS initializer to every Debug build of a Blazor Web app -->
  <!-- The initializer (Microsoft.NET.Sdk.BlazorWeb.DotNetWatch.lib.module.js) is a build-only
       static web asset that never reaches publish output, but in a Debug build it makes every
       full page load end in a Blazor-Web-Initializers comment and fetch
       /_framework/dotnet-browser-tools/hot-reload-settings.json. The suites run Debug builds and
       must see the documents a Release build serves. Clearing the asset prefix before the SDK
       defines them skips only these assets (its target also runs before
       ResolveProjectStaticWebAssets but is defined after this file, so this one runs first);
       Hot Reload's runtime options are untouched. -->
  <Target Name="CroftOmitDotNetWatchBrowserTools" BeforeTargets="ResolveProjectStaticWebAssets">
    <PropertyGroup>
      <DotNetWatchBrowserToolsAssetPrefix />
    </PropertyGroup>
  </Target>
  <!-- END WORKAROUND(W-104) -->

</Project>
