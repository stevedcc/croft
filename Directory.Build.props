<Project>
  <!-- Analyzers and code style are part of the build: the house style (writing-dotnet10-code skill)
       is enforced, not just documented. -->
  <PropertyGroup>
    <!-- The single source of the released version: the footer shows it ("Running on Croft v0.6.1"),
         read from the assembly's informational version without the +commit suffix. The release
         bumps it here. -->
    <Version>0.6.8</Version>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- Doc files are generated only so IDE0005 (unused usings) can run during build. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
</Project>
