<Project>
  <!-- Analyzers and code style are part of the build: the house style (writing-dotnet10-code skill)
       is enforced, not just documented. -->
  <PropertyGroup>
    <!-- The version local builds and tests carry; the footer shows it ("Running on Croft v0.6.1"),
         read from the assembly's informational version without the +commit suffix. A released
         image takes its version from the tag instead (release.yml passes VERSION to the
         Dockerfiles, which publish with -p:Version), so a release needs no bump here. -->
    <Version>0.6.9</Version>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- Doc files are generated only so IDE0005 (unused usings) can run during build. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <!-- Lock files (packages.lock.json) record a content hash for every package, so a restore cannot
       silently pick up different bytes (Scorecard Pinned-Dependencies). CI restores in locked mode
       and refuses a restore that does not match the committed lock files; local restores keep
       updating them. The image builds do not set CI, so their restore stays unlocked. -->
  <PropertyGroup>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode Condition="'$(CI)' == 'true'">true</RestoreLockedMode>
  </PropertyGroup>
  <!-- WORKAROUND(W-088, .NET): crossgen2 11 targets armv8.0-a + LSE for linux-arm64, which the Raspberry Pi 4 lacks, so its ReadyToRun code would be rejected there -->
  <!-- The cluster's Pi 4 nodes (Cortex-A72: fp, asimd, crc32, no atomics) run .NET 11, but an
       image whose ReadyToRun code needs LSE ("Atomics") is rejected at start and every method
       is JIT-compiled again. Pinned to what the Pi 4 has: AdvSimd (neon) and Crc32, LSE off
       (crossgen2's `-lse`; without it the optimistic light-up still requires Atomics). Only
       for linux-arm64 publishes: the amd64 image keeps the SDK default. -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' == 'linux-arm64'">
    <PublishReadyToRunCrossgen2ExtraArgs>--instruction-set:neon,crc,-lse</PublishReadyToRunCrossgen2ExtraArgs>
  </PropertyGroup>
  <!-- END WORKAROUND(W-088) -->
</Project>
