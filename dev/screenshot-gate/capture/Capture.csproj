<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- The screenshot gate's capture step: a standalone Playwright harness (not part of
       Croft.slnx or the E2E suite) that renders the fixed fixture set at 390 and 1440 in
       light and dark and saves full-page PNGs to GATE_OUT. It must build against ANY
       checkout of this repository (it runs at the comparison baseline too), so it references
       no repository code. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="Microsoft.Playwright.NUnit" Version="1.64.1" />
    <PackageReference Include="NUnit" Version="5.0.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.3.1" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="NUnit.Framework" />
  </ItemGroup>

</Project>
