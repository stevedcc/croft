# API
ConnectionStrings__BlogDb=Host=localhost;Database=blog;Username=blog;Password=blog
Oidc__Authority=http://localhost:5556/default
Oidc__ClientId=blog-web
Oidc__ClientSecret=secret
Oidc__Audience=
FileStorage__BasePath=./uploads
# Shared key between Web and API that lets the Web app forward the visitor's IP
# (dev-only value; real deployments inject it via user secrets or a k8s secret).
Analytics__IngestKey=dev-only-ingest-key
# Key the API hashes visitor IPs with (dev-only value; required outside Development).
Analytics__HashKey=dev-only-hash-key

# Web
ApiBaseUrl=http://localhost:5000/
Oidc__Authority=http://localhost:5556/default
Oidc__ClientId=blog-web
Oidc__ClientSecret=secret
Analytics__IngestKey=dev-only-ingest-key
